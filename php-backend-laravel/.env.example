APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# pgsql config
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=haraan
# DB_USERNAME=postgres
# DB_PASSWORD=secret
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Real-time content invalidation (Laravel Reverb). Set BROADCAST_CONNECTION=reverb
# in production after `composer require laravel/reverb:^2.1` (needs ext-curl) and
# `php artisan reverb:install`. Run the server with `php artisan reverb:start`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Client-side (Echo / app) values — usually mirror the server ones:
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Payments (Razorpay Standard Checkout) ---
# KEY_ID is public (safe in frontend); KEY_SECRET is server-only — never expose it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Push notifications (Firebase Cloud Messaging) ---
# Absolute path to the service-account JSON (Firebase → Project settings →
# Service accounts → Generate new private key). Unset = push is a logged no-op.
FCM_CREDENTIALS_PATH=

# --- Website phone sign-in (Firebase phone auth, SMS OTP) ---
# The WEB app config from Firebase (Project settings → General → your Web app).
# All public (they ship to the browser). Leave FIREBASE_WEB_API_KEY blank to hide
# the phone option and fall back to Google + email/password.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=haraan-1a84a.firebaseapp.com
FIREBASE_PROJECT_ID=haraan-1a84a

# --- Google Maps Platform (location quality) ---
# One BROWSER key restricted by HTTP referrer (add haraan.app + your dev host).
# Enable these APIs on it: Maps JavaScript API, Places API, Maps Embed API.
# Powers Places Autocomplete in the event/venue forms and the embedded map on the
# public detail pages. Ships to the browser by design. Blank = manual pin/text +
# plain Maps-search fallback (nothing breaks).
GOOGLE_MAPS_API_KEY=

# A SECOND key, restricted by server IP, for the calls we make from the box: the
# Street View photo of the venue on the event page (Street View Static API). The
# browser key above can't be reused — it's referrer-locked and a server request
# has no referrer to send. Blank = falls back to the browser key (fine locally,
# where it's usually unrestricted); if neither works the Street View card simply
# doesn't render.
GOOGLE_MAPS_SERVER_KEY=

# --- WhatsApp (booking confirmation, payment receipt, reminders, login OTP) ---
# Two ways to reach the SAME WhatsApp Business Account, chosen by WHATSAPP_DRIVER:
#   meta  — the WhatsApp Cloud API, direct.
#   msg91 — MSG91 as the Business Solution Provider in front of it.
# Templates are approved against the WABA, not the driver, so switching costs
# nothing and re-approves nothing.
#
# Off by default: a fresh environment must not start messaging real customers as a
# side effect of a deploy.
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=msg91
WHATSAPP_DEFAULT_COUNTRY=91

# MSG91 driver. AUTH_KEY is server-only — treat it like a password.
# MSG91_WHATSAPP_NUMBER is the number registered on the MSG91 panel, country code
# included, no plus.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
# Optional: only older WABAs need the template namespace stated.
MSG91_WHATSAPP_NAMESPACE=
MSG91_BASE_URL=https://control.msg91.com/api/v5

# Inbound webhook (customer replies, STOP opt-outs, the 24h service window).
# In the MSG91 panel: Number → Action ⋮ → Webhook. URL is
#   https://haraan.app/api/webhooks/msg91/whatsapp
# and add a request header MSG91_WEBHOOK_HEADER: MSG91_WEBHOOK_TOKEN.
# MSG91 signs nothing, so this secret is the ONLY authentication — generate a long
# random value. Blank refuses every delivery, which is the safe default.
MSG91_WEBHOOK_TOKEN=
MSG91_WEBHOOK_HEADER=X-Haraan-Token

# Set false only if the login_otp template was approved WITHOUT a copy-code button.
WHATSAPP_AUTH_TEMPLATE_HAS_BUTTON=true

# Meta driver (WHATSAPP_DRIVER=meta) — from the Meta app dashboard → WhatsApp.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_TOKEN=
META_GRAPH_VERSION=v21.0

# Outbound journeys (reminders, review requests). Separate master switch: the
# queue fills and drains its bookkeeping either way, but nothing is DELIVERED
# until this is deliberately turned on.
MESSAGING_JOURNEYS_ENABLED=false

