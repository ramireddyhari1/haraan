# Line-ending policy for the Haraan monorepo.
#
# The repository already stores every text file with LF; this machine's
# core.autocrlf=true was re-introducing CRLF on checkout, which made
# prod-vs-local hash audits (app/Support, app/Services, app/Http/Controllers)
# show phantom "differences" that were really just CRLF-vs-LF. Pinning eol=lf
# here overrides autocrlf so the working tree matches what ships to prod.

# Default: treat everything as text, auto-detect binaries by content, LF in tree.
* text=auto eol=lf

# --- Windows-only scripts MUST keep CRLF or they can misbehave ---
*.bat   text eol=crlf
*.cmd   text eol=crlf

# --- Explicit text types (belt-and-suspenders; keeps intent obvious) ---
*.php        text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.java       text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf
*.py         text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.properties text eol=lf
*.pro        text eol=lf
*.txt        text eol=lf
*.example    text eol=lf
.htaccess    text eol=lf
gradlew      text eol=lf

# --- Binary: never normalized, never text-diffed ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.woff   binary
*.woff2  binary
*.apk    binary
*.aab    binary
*.jar    binary
*.phar   binary
*.keystore binary
*.jks    binary
*.so     binary
*.dll    binary
*.db     binary
*.sqlite binary
*.sqlite3 binary
*.pb     binary
