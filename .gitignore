# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local
.env.production

# Build outputs
.next/
out/
dist/
build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local settings (machine-specific, do not publish)
.claude/

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# TypeScript
*.tsbuildinfo

# WhatsApp Web.js runtime session/cache — huge Chromium cache, never commit.
# (The deployed bridge keeps its own session on the server.)
whatsapp-api/.wwebjs_auth/
whatsapp-api/.wwebjs_cache/
**/.wwebjs_auth/
**/.wwebjs_cache/

# Session scratch — screenshots and notes captured while working, never part of the app.
# NB: a Chrome profile was committed here before this rule existed; it has been
# untracked. The old copies still live in git HISTORY — see repo notes on scrubbing.
_IGNORE_session/

# Editor/backup leftovers — never source.
*.bak
*.old
*.orig

# Kotlin compiler daemon caches / error logs (build artifact, regenerated).
.kotlin/
**/.kotlin/

# Android build outputs copied out of Gradle — published to the VPS or Play, never source.
*.apk
*.aab

# Session captures: screenshots, frame dumps, uiautomator XML dumps, store screenshots.
/_*.png
/_frames*/
/*_dump.xml
/android-app/*.png
/play-screenshots/

# Standalone HTML preview/verification pages. Anything under public/ is served on prod.
/php-backend-laravel/public/preview_*.html
/php-backend-laravel/public/*_preview.html
/php-backend-laravel/public/*_review.html
/php-backend-laravel/public/*_verify.html

# Local helper scripts, test targets and brand source files.
/php-backend-laravel/capture_employee.js
/pitch-test-target.html
/COMPANY LOGOS/
/haraan.svg
