<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: plain HTTP to the local dev server (php artisan serve over
  `adb reverse`). The main manifest forbids cleartext and release never sees this;
  a network security config takes precedence over usesCleartextTraffic.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
