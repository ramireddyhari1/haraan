<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Cleartext to the loopback hosts so a debug build can reach
  `php artisan serve`: 127.0.0.1/localhost over `adb reverse tcp:8000 tcp:8000`,
  10.0.2.2 from the emulator. Everything else, prod included, still needs TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
