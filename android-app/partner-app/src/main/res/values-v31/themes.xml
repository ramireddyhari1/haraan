<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ system splash: white window, clean blue H as the branded icon.
         The home-screen icon carries the "Partner" script; the splash shows a
         single confident mark instead of the blown-up icon lockup. -->
    <style name="Theme.HaraanPartner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
    </style>
</resources>
