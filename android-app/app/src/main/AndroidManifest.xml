<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The boundary/wicket haptic. A normal permission, granted at install with no
         prompt - but WITHOUT it declared, Vibrator.vibrate() is a silent no-op, so the
         burst plays its animation and the phone stays perfectly still. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for a phone paired INTO a match as a camera. Requested at that moment,
         never on launch: the scoring app itself has no use for a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Required to post notifications on Android 13+ (requested at runtime in MainActivity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Haraan.Splash">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          A phone joining a match AS A CAMERA. Its own Activity on purpose: this flow has
          no account, no splash and no bottom nav, and routing it through MainActivity
          would mean teaching the whole navigation graph about a mode that has none of
          those things. Keeps the screen awake because a camera pointed at the stumps
          must not sleep between deliveries.
        -->
        <activity
            android:name=".camera.CameraDeviceActivity"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:exported="true"
            android:theme="@style/Theme.Haraan.Camera">
            <!-- The app's own scheme: what the QR resolves to when Haraan is installed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haraan" android:host="camera" />
            </intent-filter>
            <!-- And the https form, which is what survives being pasted into WhatsApp. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="haraan.app" android:pathPrefix="/join/camera" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging: receives token rotations and push payloads. -->
        <service
            android:name=".push.HaraanMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel + small icon FCM uses when it renders a notification-message itself
             (app in background). Kept in sync with PushNotifications.CHANNEL_ID. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="haraan_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!-- Shares generated images (e.g. the player card) via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
